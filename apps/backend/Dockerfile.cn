# 国内网络环境部署用 Dockerfile（前端静态资源用本地已构建的 dist，Python 依赖走清华源）
# 构建上下文必须是仓库根目录：
#   docker build -f apps/backend/Dockerfile.cn -t rubbish .
FROM python:3.12-slim

WORKDIR /app

# uv 从清华源安装（避免 pypi.org 超时）
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple uv

# Word→PDF 内置转换器：LibreOffice headless + 中文字体。
# 单独成层，只有这行变化时才重建，日常代码改动仍命中后面的缓存。
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
       libreoffice-writer fonts-wqy-zenhei fonts-wqy-microhei \
    && rm -rf /var/lib/apt/lists/*

# 先拷依赖清单，利用 Docker 层缓存
COPY apps/backend/pyproject.toml apps/backend/uv.lock ./
ENV UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
RUN uv sync --no-dev

COPY apps/backend/app ./app
COPY apps/backend/alembic ./alembic
COPY apps/backend/alembic.ini ./
COPY apps/backend/deploy_server.py ./

# 前端构建产物（本地已构建）
COPY apps/backend/prebuilt-static ./static

ENV RUBBISH_STATIC_DIR=/app/static \
    RUBBISH_STORAGE_PATH=/data/uploads \
    PORT=8080
VOLUME ["/data/uploads"]
EXPOSE 8080

CMD ["sh", "-c", "uv run --no-sync alembic upgrade head && uv run --no-sync python deploy_server.py"]
