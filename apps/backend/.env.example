# Rubbish backend environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# All vars are prefixed RUBBISH_ (case-insensitive).

# --- Application identity ---
RUBBISH_APP_NAME=Rubbish API
RUBBISH_ENVIRONMENT=development
# development | staging | production | test
RUBBISH_DEBUG=false

# --- Tenancy ---
# single = one tenant per deployment (typical self-hosted)
# multi  = many tenants resolved from host header (SaaS)
RUBBISH_TENANCY_MODE=single
RUBBISH_BOOTSTRAP_TENANT_SLUG=default

# --- Database (PostgreSQL only — RLS requires PG) ---
# Example: postgresql+asyncpg://user:pass@localhost:5432/rubbish
RUBBISH_DATABASE_URL=postgresql+asyncpg://rubbish:rubbish@localhost:5432/rubbish
RUBBISH_DB_POOL_SIZE=10
RUBBISH_DB_MAX_OVERFLOW=20
RUBBISH_DB_POOL_RECYCLE=1800
RUBBISH_DB_POOL_PRE_PING=true
RUBBISH_DB_POOL_TIMEOUT=30
RUBBISH_DB_STARTUP_RETRIES=5
RUBBISH_DB_STARTUP_RETRY_DELAY=2.0

# --- Redis (cache + rate limit; empty = fail-open in-memory) ---
RUBBISH_REDIS_URL=

# --- JWT / Auth ---
# Generate with: openssl rand -hex 32
RUBBISH_SECRET_KEY=<generate-with-openssl-rand-hex-32>
RUBBISH_ACCESS_TOKEN_EXPIRE_MINUTES=15
RUBBISH_REFRESH_TOKEN_EXPIRE_DAYS=7
RUBBISH_ALGORITHM=HS256
RUBBISH_REFRESH_TOKEN_COOKIE_NAME=rubbish_refresh
# Override auto-detection (production=True, else=False):
# RUBBISH_REFRESH_TOKEN_COOKIE_SECURE=true
RUBBISH_REFRESH_TOKEN_COOKIE_SAMESITE=strict

# --- CORS / Trusted hosts ---
RUBBISH_CORS_ORIGINS=http://localhost:5173,http://localhost
RUBBISH_ALLOWED_HOSTS=localhost,127.0.0.1
RUBBISH_TRUSTED_PROXIES_COUNT=0

# --- Rate limiting ---
RUBBISH_RATE_LIMIT_PER_MINUTE=120

# --- Logging ---
RUBBISH_LOG_LEVEL=INFO
# JSON logs recommended in production
RUBBISH_JSON_LOGS=false

# --- Error monitoring (Sentry, optional) ---
# 留空 = 不启用（SDK 完全不 import）。启用前先装依赖：
#   uv sync --extra monitoring
RUBBISH_SENTRY_DSN=
# 性能追踪采样率 0~1
RUBBISH_SENTRY_TRACES_SAMPLE_RATE=0.1
# 性能剖析采样率 0~1（0 = 关闭）
RUBBISH_SENTRY_PROFILES_SAMPLE_RATE=0.0
# 是否上报 PII（IP/请求体等）。默认 false：投稿含未发表稿件与审稿人身份
RUBBISH_SENTRY_SEND_DEFAULT_PII=false

# --- DataCite DOI registration (optional) ---
# 留空 = DOI 模块返回 501 Not Implemented
RUBBISH_DATACITE_API_URL=https://api.datacite.org
# DataCite 分配的 DOI 前缀（如 10.12345）
RUBBISH_DATACITE_PREFIX=
# Base64 编码的 "username:password"，用于 DataCite MDS Basic Auth
# 生成：echo -n "username:password" | base64
RUBBISH_DATACITE_API_KEY=

# --- Full-text search (Meilisearch, optional) ---
# 留空 = 不启用（目录搜索走内置 DB ILIKE）。启用前先装依赖：
#   uv sync --extra search
# 本地体验：docker run -p 7700:7700 getmeili/meilisearch:v1.12
RUBBISH_MEILISEARCH_URL=
RUBBISH_MEILISEARCH_API_KEY=
RUBBISH_MEILISEARCH_INDEX_PREFIX=rubbish

# --- Admin bootstrap (first startup) ---
RUBBISH_ADMIN_EMAIL=Rubbish_EB@qun.mail.163.com
RUBBISH_ADMIN_USERNAME=admin
# At least 12 characters, not a common weak value
RUBBISH_ADMIN_PASSWORD=<change-me-at-least-12-chars>

# --- File storage ---
# local = 文件系统（默认，零依赖）；s3 = S3 兼容对象存储
# 切到 s3 前先装依赖：uv sync --extra s3
RUBBISH_STORAGE_BACKEND=local
RUBBISH_STORAGE_PATH=/data/uploads
# 仅 STORAGE_BACKEND=s3 时需要
RUBBISH_S3_BUCKET=
# MinIO/R2 等自建端点填 URL；AWS 官方 S3 留空
RUBBISH_S3_ENDPOINT_URL=
RUBBISH_S3_REGION=
# 留空则回退到 IAM Role / 环境变量 / ~/.aws 凭证链
RUBBISH_S3_ACCESS_KEY_ID=
RUBBISH_S3_SECRET_ACCESS_KEY=

# --- TOTP 静态加密密钥（配置硬性要求，缺失则启动失败）---
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RUBBISH_FERNET_KEY=<generate-with-fernet-generate-key>
