# Rubbish — Environment Configuration
# Copy this file to .env and fill in your values.
# cp .env.example .env
#
# All values shown below are placeholders — replace them with real secrets.

# ─── Required ────────────────────────────────────────────────────────────────
# Secret key for JWT signing. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
RUBBISH_SECRET_KEY=change-me-to-a-random-secret

# Bootstrap admin password (used on first run to create the admin user).
# Change this immediately after first login.
RUBBISH_ADMIN_PASSWORD=change-me

# Database URL (PostgreSQL with asyncpg driver).
# Format: postgresql+asyncpg://user:password@host:port/database
# 注意：docker compose 部署时这一项会被 compose 内置的 db 服务连接串
# 自动覆盖，无需手工填写（密码见下面的 POSTGRES_PASSWORD）。
RUBBISH_DATABASE_URL=postgresql+asyncpg://rubbish:change-me@localhost:5432/rubbish

# ─── docker compose 部署专用（docker-compose.yml 的 ${...} 插值读本文件）──────
# 站点域名：DNS A 记录指到 VPS IP；Caddy 据此自动签发 HTTPS。
# 没域名时填 localhost（自签证书，仅本机验证）。
SITE_DOMAIN=journal.example.com
# 内置 PostgreSQL 容器的密码。生成: python -c "import secrets;print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-strong-pg-password

# ─── Optional ────────────────────────────────────────────────────────────────
# Meilisearch for full-text search. If omitted, falls back to DB ILIKE.
# RUBBISH_MEILISEARCH_URL=http://localhost:7700
# RUBBISH_MEILISEARCH_API_KEY=change-me

# Redis for rate-limit store and token denylist.
# If omitted, uses in-memory stores (not suitable for multi-node).
# RUBBISH_REDIS_URL=redis://localhost:6379

# Environment: development | test | production
RUBBISH_ENVIRONMENT=development

# CORS origins (comma-separated, no spaces around commas).
RUBBISH_CORS_ORIGINS=http://localhost:5173

# Allowed hosts (comma-separated, no spaces).
RUBBISH_ALLOWED_HOSTS=localhost,127.0.0.1

# Admin bootstrap email and username (optional, defaults shown).
# RUBBISH_ADMIN_EMAIL=admin@example.com
# RUBBISH_ADMIN_USERNAME=admin

# Log level: DEBUG | INFO | WARNING | ERROR
RUBBISH_LOG_LEVEL=INFO

# Set to "true" for structured JSON logs (production).
RUBBISH_JSON_LOGS=false

# Storage backend: local | s3
RUBBISH_STORAGE_BACKEND=local
RUBBISH_STORAGE_PATH=/data/uploads

# Token expiration (minutes for access, days for refresh).
RUBBISH_ACCESS_TOKEN_EXPIRE_MINUTES=15
RUBBISH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Fernet key for encrypting TOTP secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RUBBISH_FERNET_KEY=change-me

# Rate limit — requests per minute per IP per route.
# 反向代理（Caddy/Nginx）后面部署时把 TRUSTED_PROXIES_COUNT 设为代理跳数
# （Caddy 同容器网络 = 1），否则所有用户共享代理 IP，限流会误伤。
RUBBISH_RATE_LIMIT_PER_MINUTE=120
# RUBBISH_TRUSTED_PROXIES_COUNT=1

# ─── S3 Storage (optional, requires RUBBISH_STORAGE_BACKEND=s3) ────────────
# RUBBISH_S3_BUCKET=rubbish-uploads
# RUBBISH_S3_REGION=us-east-1
# RUBBISH_S3_ENDPOINT_URL=https://s3.amazonaws.com
# RUBBISH_S3_ACCESS_KEY_ID=change-me
# RUBBISH_S3_SECRET_ACCESS_KEY=change-me

# ─── OIDC / SSO (optional) ───────────────────────────────────────────────────
# RUBBISH_OIDC_GOOGLE_CLIENT_ID=change-me
# RUBBISH_OIDC_GOOGLE_CLIENT_SECRET=change-me
# RUBBISH_OIDC_ORCID_CLIENT_ID=change-me
# RUBBISH_OIDC_ORCID_CLIENT_SECRET=change-me

# ─── Email (optional; console backend by default) ───────────────────────────
# 未配置时：验证/找回密码邮件打印到日志，注册与登录流程完全可用（不阻断）。
# 配置后自动启用：邮箱验证、找回密码、审稿邀请/催办、裁决通知。
#
# 常见服务商速查（端口与 TLS 组合别配错，否则会连接超时）：
#   腾讯企业邮  smtp.exmail.qq.com   465 + USE_TLS=true           587 + USE_TLS=false STARTTLS=true
#   QQ 邮箱     smtp.qq.com          465 + USE_TLS=true           587 + STARTTLS
#   163 邮箱    smtp.163.com         465 + USE_TLS=true           25/587 + STARTTLS
#   Gmail       smtp.gmail.com       465 + USE_TLS=true           587 + STARTTLS（需应用专用密码）
#   SendGrid    smtp.sendgrid.net    587 + STARTTLS               (用户名固定 apikey)
#   Mailgun     smtp.mailgun.org     587 + STARTTLS
#   AWS SES     email-smtp.<region>.amazonaws.com  587 + STARTTLS
#
# 外发总闸：默认关闭。开发阶段即使填了真实组邮箱授权码，邮件也只写日志，
# 绝不投递给真实收件人。上线前确认收件范围、经负责人同意后再设为 true。
# RUBBISH_EMAIL_OUTBOUND_ENABLED=false
# RUBBISH_EMAIL_BACKEND=smtp
# RUBBISH_EMAIL_SMTP_HOST=smtp.example.com
# RUBBISH_EMAIL_SMTP_PORT=465
# RUBBISH_EMAIL_SMTP_USER=change-me
# RUBBISH_EMAIL_SMTP_PASSWORD=change-me
# 465 端口（隐式 TLS）设 true；587 端口设 false 并保持 STARTTLS=true
# RUBBISH_EMAIL_SMTP_USE_TLS=true
# RUBBISH_EMAIL_SMTP_STARTTLS=false
# RUBBISH_EMAIL_SMTP_TIMEOUT=15
# RUBBISH_EMAIL_SMTP_RETRIES=2
# 发件地址必须与 SMTP 账号同域，否则多数服务商会拒发（伪造发件人）
# RUBBISH_EMAIL_FROM_ADDRESS=noreply@example.com
# RUBBISH_EMAIL_FROM_NAME=Rubbish
#
# 多账号发信池（可选，优先于上面的单账号配置）。JSON 数组，按顺序轮询；
# 某个账号连续失败会被暂时摘除，另一个继续发，单个邮箱被限流不影响全站。
# RUBBISH_EMAIL_SMTP_ACCOUNTS=[{"host":"smtp.126.com","port":465,"username":"a@126.com","password":"<auth-code>","from_address":"a@126.com","from_name":"Rubbish","use_tls":true},{"host":"smtp.qq.com","port":465,"username":"b@foxmail.com","password":"<auth-code>","from_address":"b@foxmail.com","from_name":"Rubbish","use_tls":true}]
# 账号熔断：连续失败 N 次后暂停使用该账号 M 秒
# RUBBISH_EMAIL_SMTP_BREAKER_THRESHOLD=2
# RUBBISH_EMAIL_SMTP_BREAKER_COOLDOWN=180
# 收件地址护栏（防轰炸，正常用户无感）：同一地址最短发信间隔 / 滚动窗口上限
# RUBBISH_EMAIL_PER_ADDRESS_COOLDOWN=45
# RUBBISH_EMAIL_PER_ADDRESS_WINDOW_MINUTES=30
# RUBBISH_EMAIL_PER_ADDRESS_LIMIT=6
# 邮件里的深链前缀（不带结尾斜杠）
# RUBBISH_FRONTEND_BASE_URL=https://rubbish.argjiemi.cn
# 站点名（邮件标题与正文）
# RUBBISH_SITE_NAME=Rubbish
# 进程内定时任务（审稿催办，每 6 小时一轮）；多实例部署只在其中一个开启
# RUBBISH_SCHEDULER_ENABLED=true

# ─── Frontend build-time vars (Vite, optional) ───────────────────────────────
# 前端在构建时读取 VITE_* 变量；这些是「支持本刊」页的收款信息。
# 全部留空时页面只显示文字渠道（无收款码、无账号），不会报错。
# VITE_SUPPORT_QRCODE_URL=/covers/support-qrcode.png
# VITE_SUPPORT_ACCOUNT=支付宝 example@example.com
# VITE_SUPPORT_NOTE=赞助自愿，不与投稿或评审挂钩。
# VITE_SUPPORT_EMAIL=editorial@argjiemi.cn

# ─── Sentry / Error Monitoring (optional) ────────────────────────────────────
# RUBBISH_SENTRY_DSN=https://change-me@o0.ingest.sentry.io/0

# ─── Key Rotation ────────────────────────────────────────────────────────────
# Comma-separated list of previous secret keys for rotation.
# RUBBISH_PREVIOUS_SECRET_KEYS=

# ─── DOI / DataCite (optional) ───────────────────────────────────────────────
# RUBBISH_DATACITE_PREFIX=10.xxxxx
# RUBBISH_DATACITE_USERNAME=change-me
# RUBBISH_DATACITE_PASSWORD=change-me
